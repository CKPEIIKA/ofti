{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofti.dev/schemas/ofti.dictionary-transaction.v1.schema.json",
  "title": "OFTI Dictionary Transaction v1",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "created_at",
    "case",
    "applied",
    "rolled_back",
    "snapshot",
    "edits",
    "files"
  ],
  "properties": {
    "format": {"const": "ofti.dictionary-transaction"},
    "format_version": {"const": 1},
    "created_at": {"type": "string"},
    "case": {"type": "string"},
    "applied": {"type": "boolean"},
    "rolled_back": {"type": "boolean"},
    "snapshot": {"type": "string"},
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "key", "before", "after", "existed", "operation"],
        "properties": {
          "file": {"type": "string"},
          "key": {"type": "string"},
          "before": {"type": ["string", "null"]},
          "after": {"type": "string"},
          "existed": {"type": "boolean"},
          "operation": {"enum": ["update", "insert"]}
        },
        "additionalProperties": true
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "before_sha256", "after_sha256", "diff"],
        "properties": {
          "path": {"type": "string"},
          "before_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "diff": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
